# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

.idea
.vscode
coverage
dist
node_modules

# Legacy Ionic app (apps/legacy-ionic)
.angular
.ionic
.sass-cache
.sourcemaps
.versions
/apps/legacy-ionic/platforms
/apps/legacy-ionic/plugins
/apps/legacy-ionic/www

# Flutter app (apps/mobile) — see apps/mobile/.gitignore for the full list
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/apps/mobile/build/

# Deployment (deploy/, docs/DEPLOYMENT.md): never commit server secrets
/.env
/.env.production
/releases/

# Backend env files hold secrets; only the template is committed.
/apps/backend/.env*
!/apps/backend/.env.template
