# Production settings for the server stack (/opt/iftar/.env).
# The GitHub workflow writes this file from repository Variables and Secrets
# (docs/DEPLOYMENT.md); copy it only to deploy by hand from a laptop.

# Server hostname = GitHub variable SERVER_HOST (HTTPS certificate is issued for it)
DOMAIN=vps-xxxxxxxx.vps.ovh.net
# Let's Encrypt contact = GitHub variable ACME_EMAIL
ACME_EMAIL=you@example.com

APP_ENV=production
APP_TIMEZONE=Africa/Tunis
DB_PORT=5432
DB_NAME=iftar_db
DB_USER=iftar
# Secrets (GitHub secrets of the same name)
DB_PASS=change-me
DEFAULT_ADMIN_USER_PASSWORD=change-me
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=
JWT_ACCESS_TOKEN_EXP_IN_SEC=86400
JWT_REFRESH_TOKEN_EXP_IN_SEC=2592000
